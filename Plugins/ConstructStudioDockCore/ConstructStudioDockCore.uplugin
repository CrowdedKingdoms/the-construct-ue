{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "0.1.0",
  "FriendlyName": "Construct Studio Dock Core",
  "Description": "The live Studio dock browser, host interface and typed events.",
  "Category": "Construct",
  "CanContainContent": false,
  "EnabledByDefault": true,
  "SupportedTargetPlatforms": ["Win64"],
  "Modules": [
    {
      "Name": "ConstructStudioDockCore",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "PlatformAllowList": ["Win64"]
    }
  ],
  "Plugins": [
    {
      "Name": "ConstructPresence",
      "Enabled": true
    },
    {
      "Name": "ConstructShell",
      "Enabled": true
    },
    {
      "Name": "CrowdySDK",
      "Enabled": true
    },
    {
      "Name": "WebBrowserWidget",
      "Enabled": true
    }
  ]
}
