# Guarded dv commands: this list comes from AGENTS.md section 6; change it there first.
prefix_rule(pattern = ["dv", "repo", "-d"], decision = "forbidden", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "obliterate"], decision = "forbidden", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "prune"], decision = "forbidden", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "branch", "-d"], decision = "forbidden", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "branch", "-r"], decision = "forbidden", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "tag", "-d"], decision = "forbidden", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "tag", "-m"], decision = "forbidden", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "commit", "--no-verify"], decision = "forbidden", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "merge", "--delete-branch"], decision = "forbidden", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "conflict-backups", "clear"], decision = "forbidden", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "lock", "-d", "-f"], decision = "forbidden", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "lock", "-d", "-f"], decision = "forbidden", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "merge", "--into"], decision = "prompt", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "merge", "--conflict_resolution"], decision = "prompt", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "update", "--conflict_resolution"], decision = "prompt", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "revert", "--conflict_resolution"], decision = "prompt", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "checkout", "--discard-changes"], decision = "prompt", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "reset"], decision = "prompt", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "clean"], decision = "prompt", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "revert-to-commit"], decision = "prompt", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "workspace", "delete"], decision = "prompt", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "unregister"], decision = "prompt", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "submodule", "repin"], decision = "prompt", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "submodule", "add"], decision = "prompt", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "submodule", "rm"], decision = "prompt", justification = "Guarded dv command, AGENTS.md section 6")
prefix_rule(pattern = ["dv", "tag", "-c"], decision = "prompt", justification = "Guarded dv command, AGENTS.md section 6")
